{
  "name": "爪爪日报 PawPress",
  "short_name": "爪爪日报",
  "description": "卡通小猫 × 复古报刊风格的数据自持记账 PWA，支持微信/支付宝账单导入与 GitHub 同步",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f4ecd9",
  "theme_color": "#f4ecd9",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "记一笔",
      "short_name": "记一笔",
      "description": "快速记一笔账",
      "url": "./#add",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}